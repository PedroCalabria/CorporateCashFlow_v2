# Normalize line endings: LF in the repo, auto on checkout for the host OS
* text=auto eol=lf

# Windows-specific scripts keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Shell scripts and Dockerfiles must stay LF (they run in Linux containers)
*.sh         text eol=lf
Dockerfile   text eol=lf
*.Dockerfile text eol=lf

# Binaries
*.png binary
*.jpg binary
*.ico binary
*.pfx binary
